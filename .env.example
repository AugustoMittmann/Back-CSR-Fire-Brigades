# --- Server -------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Supabase -----------------------------------------------------------
# Server-only — NEVER expose the service role key to the frontend.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.PLACEHOLDER.PLACEHOLDER

# --- Auth0 --------------------------------------------------------------
# Create an API in the Auth0 dashboard (Applications -> APIs -> Create API).
# The "Identifier" you set there is the value of AUTH0_AUDIENCE.
AUTH0_DOMAIN=dev-8y2qkhuvs14m3ieq.us.auth0.com
AUTH0_AUDIENCE=https://api.conexaobrigada.com

# --- CORS ---------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
FRONTEND_ORIGIN_DEV=http://localhost:3000
FRONTEND_ORIGIN_PROD=

# --- Reverse proxy ------------------------------------------------------
# Set to 1 (or a CIDR) when running behind a load balancer / reverse proxy
# so req.ip is taken from X-Forwarded-For. Defaults to 0 (no trust) for safety.
TRUST_PROXY=0
