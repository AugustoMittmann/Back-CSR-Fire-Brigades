# --- Server -------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Supabase -----------------------------------------------------------
# Server-only — NEVER expose the service role key or JWT secret to the frontend.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.PLACEHOLDER.PLACEHOLDER

# HS256 secret used to verify Supabase Auth JWTs sent by the frontend.
# Find it at: Supabase Dashboard → Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=replace-with-the-jwt-secret-from-the-dashboard

# --- CORS ---------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
FRONTEND_ORIGIN_DEV=http://localhost:3000
FRONTEND_ORIGIN_PROD=

# --- Reverse proxy ------------------------------------------------------
# Set to 1 (or a CIDR) when running behind a load balancer / reverse proxy
# so req.ip is taken from X-Forwarded-For. Defaults to 0 (no trust) for safety.
TRUST_PROXY=0

# --- Auth0 (API auth) ---------------------------------------------------
# The frontend logs in via Auth0 and sends an RS256 access token; the API
# verifies it against the tenant JWKS. SUPABASE_JWT_SECRET above is legacy.
# ISSUER must end with a trailing slash (matches the token iss claim).
AUTH0_ISSUER_BASE_URL=https://dev-xxxxxxxx.us.auth0.com/
# Must match NEXT_PUBLIC_AUTH0_AUDIENCE on the frontend.
AUTH0_AUDIENCE=https://your-api-identifier/

# --- Auth0 Management API (user CRUD for admin panel) --------------------
# A Machine-to-Machine app authorized on the Auth0 Management API with scopes:
# read:users create:users update:users update:users_app_metadata
AUTH0_MGMT_CLIENT_ID=your-m2m-client-id
AUTH0_MGMT_CLIENT_SECRET=your-m2m-client-secret
# Usually the tenant Management API audience:
AUTH0_MGMT_AUDIENCE=https://your-tenant.us.auth0.com/api/v2/
# DB connection new users are created in (must be enabled for the SPA):
AUTH0_DB_CONNECTION=Username-Password-Authentication
